PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pachavellam
DB_USERNAME=root
DB_PASSWORD=

# Must match Laravel's web/.env JWT_SECRET exactly — this is how Node verifies
# the same tokens Laravel issues, without ever calling back to Laravel.
JWT_SECRET=
JWT_ALGO=HS256

# Where uploaded chat media is written on disk. Point this at Laravel's public
# storage root (web/storage/app/public) so files are servable through the
# existing /storage/... route with zero changes on the Laravel side.
MEDIA_STORAGE_ROOT=../web/storage/app/public
PUBLIC_MEDIA_BASE_URL=https://www.pachavellam.com/storage

# Internal, server-to-server push dispatch (see Laravel's routes/internal.php).
LARAVEL_INTERNAL_PUSH_URL=https://www.pachavellam.com/internal/push/chat-message
CHAT_PUSH_INTERNAL_SECRET=

CORS_ORIGIN=*
